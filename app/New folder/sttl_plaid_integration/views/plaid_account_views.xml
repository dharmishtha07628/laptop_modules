<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="plaid_account_view_form" model="ir.ui.view">
        <field name="name">plaid.account.view.form</field>
        <field name="model">plaid.account</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"></field>
                            <field name="account_id"></field>
                            <field name="currency_id"></field>
                        </group>
                        <group>
                            <field name="balance"></field>
                            <field name="account_type"></field>
                            <field name="account_subtype"></field>
                            <field name="bank_id" widget="many2one"></field>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

</odoo>
