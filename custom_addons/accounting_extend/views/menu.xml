<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account.action_move_journal_line" model="ir.actions.act_window">
        <field name="name">General Ledger</field>
        <field name="context">{'edit': 0,'create': 0, 'default_move_type': 'entry', 'search_default_posted':1, 'view_no_maturity': True}</field>
    </record>

    <record id="account.menu_action_move_journal_line_form" model="ir.ui.menu">
        <field name="name">General Ledger</field>
        <field name="parent_id" ref="account.menu_finance_entries"/>
    </record>

    <record id="action_new_journal_entry" model="ir.actions.act_window">
        <field name="name">New Journal Entry</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">form</field>
        <field name="context">{'default_move_type': 'entry', 'search_default_posted':1, 'view_no_maturity':
            True,'is_name_not_show':True}
        </field>
    </record>
    <menuitem id="menu_accounting_new_journal_entry"
              name="New Journal Entry"
              action="action_new_journal_entry"
              parent="account.menu_finance_entries"
              sequence="1"
    />

    <record id="action_import_journal_entry" model="ir.actions.act_window">
        <field name="name">Journal Entries</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('move_type','=','entry')]</field>
         <field name="context">{
             'default_move_type': 'entry',
            'import_template_label': 'Import Template for Journal Entry',
            'import_template_template': '/accounting_extend/static/imports_functionality/jorunal_entry_template.xlsx'
            }
        </field>
        <field name="view_id" ref="account.view_move_tree"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a journal entry
            </p>
            <p>
               Import Journal Entry using Excel
            </p>
        </field>
    </record>

      <menuitem id="menu_accounting_import_journal_entry"
              name="Journal Entries"
              action="action_import_journal_entry"
              parent="account.menu_finance_entries"
              sequence="2"
    />


