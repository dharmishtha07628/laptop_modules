<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="product_template_view_tree_inherit_revenue" model="ir.ui.view">
        <field name="name">product.template.tree</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <tree string="Products" sample="1">
                <field name="default_code"/>
                <field name="name"/>
                <field name="list_price" string="Sales Price"/>
                <!--                    <field name="taxes_id" widget="many2many_tags"/>-->
                <!--                    <field name="supplier_taxes_id" widget="many2many_tags"/>-->
                <!--                    <field name="activity_exception_decoration" widget="activity_exception"/>-->
            </tree>
        </field>
    </record>

    <record id="product_template_view_tree_inherit_expense" model="ir.ui.view">
        <field name="name">product.template.tree</field>
        <field name="model">product.template</field>
        <field name="arch" type="xml">
            <tree string="Products" sample="1">
                <field name="default_code"/>
                <field name="name"/>
                <field name="standard_price" string="Purchase Price"/>
                <!--                    <field name="taxes_id" widget="many2many_tags"/>-->
                <!--                    <field name="supplier_taxes_id" widget="many2many_tags"/>-->
                <!--                    <field name="activity_exception_decoration" widget="activity_exception"/>-->
            </tree>
        </field>
    </record>

    <record id="account.product_product_action_sellable" model="ir.actions.act_window">
        <field name="name">Revenue Codes</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{
            'search_default_filter_to_sell': 1,
            'default_sale_ok':True,
            'default_purchase_ok':False,
            'default_sellable':True,
            'default_purchasable':False,
            'import_template_label': 'Import Template for Revenue Codes',
            'import_template_template': '/accounting_extend/static/imports_functionality/Revenue_Code.xlsx',
            'allow_fields': ['name', 'default_code', 'list_price', 'default_memo', 'categ_id',
            'property_account_income_id', 'company_id']
            }
        </field>
        <field name="domain">[('sale_ok','=',True)]</field>
        <field name="view_id" ref="product_template_view_tree_inherit_revenue"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new sellable product
            </p>
        </field>
    </record>

    <record id="account.product_product_action_purchasable" model="ir.actions.act_window">
        <field name="name">Expense Codes</field>
        <field name="res_model">product.template</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{
            'search_default_filter_to_purchase': 1,
            'default_purchase_ok':True,
            'default_sale_ok':False,
            'default_sellable':False,
            'default_purchasable':True,
            'import_template_label': 'Import Template for Expense Codes',
            'import_template_template': '/accounting_extend/static/imports_functionality/Expense_Code.xlsx',
            'allow_fields': ['name', 'default_code', 'standard_price', 'default_memo', 'categ_id',
            'property_account_expense_id', 'company_id']
            }
        </field>
        <field name="view_id" ref="product_template_view_tree_inherit_expense"/>
        <field name="domain">[('purchase_ok','=',True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new purchasable product
            </p>
        </field>
    </record>

    <record id="accounting_extend_inherited_account_product_template_form_view" model="ir.ui.view">
        <field name="name">accounting_extend_inherited_account_product_template_form_view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='invoicing']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="accounting_extend_inherited_product_product_product_tree_view" model="ir.ui.view">
        <field name="name">product.product.tree</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">
            <field name="standard_price" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </field>
            <xpath expr="//button[@name='action_open_label_layout']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <field name="default_code" position="attributes">
                <attribute name="string">Short Code</attribute>
            </field>
            <field name="barcode" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </field>
        </field>
    </record>

    <record id="accounting_extend_inherited_account_product_template_view_tree" model="ir.ui.view">
        <field name="name">product.template.tree</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="account.product_template_view_tree"/>
        <field name="arch" type="xml">
            <!--            <field name="taxes_id" position="attributes">-->
            <!--                <attribute name="invisible">1</attribute>-->
            <!--            </field>-->
            <!--            <field name="taxes_id" position="replace"/>-->
            <!--            <field name="supplier_taxes_id" position="replace"/>-->
            <field name="list_price" position="attributes">
                <attribute name="column_invisible">not context.get('default_sellable')</attribute>
            </field>
            <!--                <attribute name="string">Sales Price</attribute>-->
            <!--                <attribute name="optional">hide</attribute>-->
            <!--                <attribute name="readonly">not context.get('default_sellable')</attribute>-->
            <!--            </field>-->
            <field name="list_price" position="after">
                <field name="standard_price" string="Purchase Price"
                       column_invisible="not context.get('default_purchasable')"/>
            </field>
            <field name="default_code" position="attributes">
                <attribute name="string">Short Code</attribute>
            </field>
        </field>
    </record>

    <record id="accounting_extend_inherited_product_product_template_view_tree_tag" model="ir.ui.view">
        <field name="name">product.template.tree</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_view_tree_tag"/>
        <field name="arch" type="xml">
            <field name="default_code" position="attributes">
                <attribute name="string">Short Code</attribute>
            </field>
        </field>
    </record>

    <record id="accounting_extend_inherited_product_product_product_view_tree_tag" model="ir.ui.view">
        <field name="name">product.product.tree</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_view_tree_tag"/>
        <field name="arch" type="xml">
            <field name="default_code" position="attributes">
                <attribute name="string">Code</attribute>
            </field>
        </field>
    </record>

    <record id="accounting_extend_inherited_product_product_normal_form_view" model="ir.ui.view">
        <field name="name">product.product.form</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <field name="list_price" position="attributes">
                <attribute name="string">Sales Price</attribute>
                <attribute name="invisible">not context.get('default_sellable')</attribute>
            </field>
            <field name="default_code" position="attributes">
                <attribute name="string">Code</attribute>
            </field>
            <field name="barcode" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>

        </field>
    </record>

    <record id="accounting_extend_inherited_product_product_template_only_form_view" model="ir.ui.view">
        <field name="name">product.template.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <!--            <field name="default_code" position="attributes">-->
            <!--                <attribute name="string">Short Code</attribute>-->
            <!--            </field>-->
            <field name="default_code" position="replace"/>
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <group>
                    <group>
                        <field name="default_code" string="Short Code"/>
                    </group>
                </group>
            </xpath>
            <field name="barcode" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="categ_id" position="after">
                <field name="default_memo"/>
            </field>
        </field>
    </record>

    <record id="accounting_extend_inherited_product_product_template_tree_view" model="ir.ui.view">
        <field name="name">product.template.tree</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">
            <field name="name" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </field>

            <field name="name" position="after">
                <field name="name" string="Revenue Name" column_invisible="not context.get('default_sellable')"/>
            </field>

            <field name="name" position="after">
                <field name="name" string="Expense Name" column_invisible="not context.get('default_purchasable')"/>
            </field>

            <field name="detailed_type" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </field>
            <xpath expr="//button[@name='action_open_label_layout']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <field name="barcode" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </field>
            <field name="standard_price" position="attributes">
                <attribute name="string">Purchase Price</attribute>
                <attribute name="column_invisible">not context.get('default_purchasable')</attribute>
            </field>
            <field name="list_price" position="attributes">
                <attribute name="string">Sales Price</attribute>
                <attribute name="column_invisible">not context.get('default_sellable')</attribute>
            </field>
            <field name="default_code" position="attributes">
                <attribute name="string">Short Code</attribute>
            </field>
        </field>
    </record>

    <record id="accounting_extend_inherited_product_product_variant_easy_edit_view" model="ir.ui.view">
        <field name="name">product.product.form</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='standard_price']" position="attributes">
                <attribute name="string">Purchase Price</attribute>
                <attribute name="invisible">not context.get('default_purchasable')</attribute>
            </xpath>
            <xpath expr="//button[@name='action_open_label_layout']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <field name="standard_price" position="attributes">
                <attribute name="string">Purchase Price</attribute>
                <attribute name="invisible">not context.get('default_purchasable')</attribute>
            </field>
            <field name="default_code" position="replace"/>
            <xpath expr="//div[hasclass('oe_title')]" position="after">
                <group>
                    <group>
                        <field name="default_code" string="Short Code"/>
                    </group>
                </group>
            </xpath>
            <!--            <field name="default_code" position="attributes">-->
            <!--                <attribute name="string">Code</attribute>-->
            <!--            </field>-->
            <field name="barcode" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
        </field>
    </record>

    <record id="accounting_extend_inherited_product_product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <field name="sale_ok" invisible="1"/>
            <xpath expr="//group[@name='group_general']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//page[@name='sales']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//button[@name='action_open_label_layout']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <field name="product_tooltip" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <xpath expr="//page[@name='purchase']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <field name="supplier_taxes_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="detailed_type" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="list_price" position="attributes">
                <attribute name="string">Sale Price</attribute>
                <attribute name="invisible">not sale_ok</attribute>
                <!--                <attribute name="invisible">not context.get('default_sellable')</attribute>-->
            </field>
            <!--            <xpath expr="//div[@name='pricing']" position="attributes">-->
            <!--                <attribute name="invisible">not sale_ok</attribute>-->
            <!--            </xpath>-->
            <xpath expr="//label[@for='list_price']" position="attributes">
                <attribute name="string">Sale Price</attribute>
                <attribute name="invisible">not sale_ok</attribute>
                <!--                <attribute name="invisible">not context.get('default_sellable')</attribute>-->
            </xpath>

            <field name="tax_string" position="attributes">
                <attribute name="invisible">not sale_ok</attribute>
            </field>

            <field name="taxes_id" position="attributes">
                <attribute name="invisible">not sale_ok</attribute>
            </field>

            <xpath expr="//label[@for='name']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <xpath expr="//label[@for='name']" position="after">
                <label for="name" string="Revenue Name" invisible="not context.get('default_sellable')"/>
            </xpath>

            <xpath expr="//label[@for='name']" position="after">
                <label for="name" string="Expense Name" invisible="not context.get('default_purchasable')"/>
            </xpath>

            <field name="categ_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>

            <field name="categ_id" position="after">
                <field name="categ_id" string="Expense Category" invisible="not context.get('default_purchasable')"/>
                <field name="property_account_expense_id" string="General Ledger Account"
                       groups="account.group_account_readonly" invisible="not context.get('default_purchasable')"/>
            </field>

            <field name="categ_id" position="after">
                <field name="categ_id" string="Revenue Category" invisible="not context.get('default_sellable')"/>
                <field name="property_account_income_id" string="General Ledger Account"
                       groups="account.group_account_readonly" invisible="not context.get('default_sellable')"/>
            </field>

            <field name="sale_ok" position="attributes">
                <attribute name="invisible">1</attribute>
                <!--                <attribute name="string">Revenue Codes</attribute>-->
            </field>

            <field name="purchase_ok" position="attributes">
                <attribute name="invisible">1</attribute>
                <!--                <attribute name="string">Expense Codes</attribute>-->
            </field>

            <field name="product_tag_ids" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>

            <!--            <field name="product_tag_ids" position="after">-->
            <!--                <field name="product_tag_ids" string="Expense Template Tags" widget="many2many_tags"-->
            <!--                       context="{'product_template_id': id}" invisible="not context.get('default_purchasable')"/>-->
            <!--            </field>-->

            <!--            <field name="product_tag_ids" position="after">-->
            <!--                <field name="product_tag_ids" string="Revenue Template Tags" widget="many2many_tags"-->
            <!--                       context="{'product_template_id': id}" invisible="not context.get('default_sellable')"/>-->
            <!--            </field>-->

            <xpath expr="//div[@name='pricing']" position="attributes">
                <attribute name="invisible">not sale_ok</attribute>
            </xpath>
            <field name="taxes_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <xpath expr="//field[@name='standard_price']" position="attributes">
                <attribute name="invisible">not purchase_ok</attribute>
            </xpath>
            <xpath expr="//label[@for='standard_price']" position="attributes">
                <attribute name="string">Purchase Price</attribute>
                <attribute name="invisible">not purchase_ok</attribute>
                <!--                <attribute name="invisible">not context.get('default_purchasable')</attribute>-->
            </xpath>

            <xpath expr="//div[@name='standard_price_uom']" position="attributes">
                <attribute name="class">o_row</attribute>
            </xpath>

            <xpath expr="//div[@name='standard_price_uom']" position="inside">
                <span class="ms-2"/>
                <field name="supplier_tax_string"/>
            </xpath>
            <xpath expr="//div[@name='standard_price_uom']" position="attributes">
                <attribute name="invisible">not purchase_ok</attribute>
                <!--                <attribute name="invisible">not context.get('default_purchasable')</attribute>-->
            </xpath>
        </field>
    </record>


    <record id="accounting_extend_inherited_product_category_list_view" model="ir.ui.view">
        <field name="name">product.category.list</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_list_view"/>
        <field name="arch" type="xml">
            <field name="display_name" position="attributes">
                <attribute name="string">Reporting Categories</attribute>
            </field>
        </field>
    </record>

</odoo>
