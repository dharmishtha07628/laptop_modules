<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <data noupdate="1">
        <!-- <delete id="account.action_move_switch_move_type" model="ir.actions.server"/>
        <delete id="account_payment.action_invoice_order_generate_link" model="ir.actions.act_window"/>
        <delete id="account.model_account_move_action_share" model="ir.actions.server"/>
        <delete id="account.action_account_invoice_from_list" model="ir.actions.server"/> -->
    </data>

    <data>
        <record id="account.menu_action_move_in_receipt_type" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>
        <record id="account.menu_account_supplier_accounts" model="ir.ui.menu">
            <field name="active" eval="False"/>
        </record>

        <record id="account.account_invoices" model="ir.actions.report">
            <field name="name">Print</field>
            <field name="binding_model_id" eval="False"/>
        </record>
        <function name="write" model="ir.model.data">
            <function name="search" model="ir.model.data">
                <value eval="[('module', '=', 'account'), ('name', '=', 'action_account_resequence')]"/>
            </function>
            <value eval="{'noupdate': False}"/>
        </function>

        <record id="account.action_account_resequence" model="ir.actions.act_window">
            <field name="binding_model_id" eval="False"/>
        </record>

        <function name="write" model="ir.model.data">
            <function name="search" model="ir.model.data">
                <value eval="[('module', '=', 'account'), ('name', '=', 'action_account_resequence')]"/>
            </function>
            <value eval="{'noupdate': True}"/>
        </function>

        <record id="account.invoice_send" model="ir.actions.server">
            <field name="binding_model_id" eval="False"/>
        </record>
        <record id="account.action_validate_account_move" model="ir.actions.act_window">
            <field name="binding_model_id" eval="False"/>
        </record>
        <record id="account.action_view_account_move_reversal" model="ir.actions.act_window">
            <field name="binding_model_id" eval="False"/>
        </record>
        <record id="account.account_invoices_without_payment" model="ir.actions.report">
            <field name="binding_model_id" eval="False"/>
        </record>

        <record id="account.menu_action_move_in_invoice_type" model="ir.ui.menu">
            <field name="name">Vendor Bills</field>
        </record>

        <record id="view_account_invoice_filter" model="ir.ui.view">
            <field name="name">account.invoice.select.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_account_invoice_filter"/>
            <field name="arch" type="xml">
                <xpath expr="//search/group" position="inside">
                    <filter name="payment _status" string="Payment Status" context="{'group_by':'payment_state'}"/>
                </xpath>
                <field name="name" position="after">
                    <field name="display_name" string="Bill No." filter_domain="[('display_name','ilike',self)]"/>
                </field>
            </field>
        </record>

        <record id="view_vendor_bill_attachment" model="ir.ui.view">
            <field name="name">Vendor Bill: Attachments</field>
            <field name="model">account.move</field>
            <field eval="1000" name="priority"/>
            <field name="arch" type="xml">
                <form string="Vendor Bill: Attachments" readonly="1">
                    <field name="attachment_ids" widget="many2many_binary" readonly="1" nolabel="1"/>
                    <footer/>
                </form>
            </field>
        </record>

        <record id="view_in_invoice_bill_tree_vendor" model="ir.ui.view">
            <field name="name">account.out.invoice.tree</field>
            <field name="model">account.move</field>
            <field name="mode">primary</field>
            <field eval="10" name="priority"/>
            <field name="arch" type="xml">
                <tree js_class="account_tree">
                    <field name="partner_id" string="Vendor"/>
                    <field name="invoice_date"/>
                    <field name="invoice_date_due"/>
                    <field name="vendor_bill_ref" string="Vendor Bill No."/>
                    <field name="ref" string="Bill Description"/>
                    <field name="amount_total_signed" string="Total" sum="Total"/>
                    <field name="amount_residual_signed" string="Amount Due" sum="Total Amount Due"/>
                    <field name="to_check"/>
                    <field name="state"/>
                    <field name="payment_state"/>
                    <!--                    <field name="email_status"/>-->
                    <field name="attachment_ids" column_invisible="1"/>
                    <button name="action_open_vendor_bill_attachment" title="View Attachments" type="object"
                            icon="fa-paperclip fw-bolder" invisible="not attachment_ids"/>
                </tree>
            </field>
        </record>

        <record id="view_out_invoice_bill_tree_customer" model="ir.ui.view">
            <field name="name">account.out.invoice.tree</field>
            <field name="model">account.move</field>
            <field name="mode">primary</field>
            <field name="arch" type="xml">
                <tree js_class="account_tree">
                    <field name="made_sequence_hole" column_invisible="True"/>
                    <field name="partner_id" string="Customer"/>
                    <field name="name" decoration-bf="1" decoration-danger="made_sequence_hole"/>
                    <field name="invoice_date" string="Invoice Date"/>
                    <field name="invoice_date_due"/>
                    <field name="amount_total_signed" string="Total" sum="Total"/>
                    <field name="amount_residual_signed" string="Amount Due" sum="Total Amount Due"/>
                    <field name="to_check"/>
                    <field name="state"/>
                    <field name="payment_state"/>
                    <field name="email_status"/>
                </tree>
            </field>
        </record>

        <record id="account.action_move_in_invoice_type" model="ir.actions.act_window">
            <field name="name">Vendor Bills</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_in_invoice_bill_tree_vendor"/>
            <field name="search_view_id" ref="account.view_account_invoice_filter"/>
            <field name="domain">[('move_type', '=', 'in_invoice')]</field>
            <field name="context">{'default_move_type': 'in_invoice', 'display_account_trust': True}</field>
            <!--            'search_default_status':1,'search_default_payment_status':1-->
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a vendor bill
                </p>
                <p>
                    Create invoices, register payments and keep track of the discussions with your vendors.
                </p>
            </field>
        </record>

        <record id="account.action_move_out_invoice_type" model="ir.actions.act_window">
            <field name="name">Customer Invoices</field>
            <field name="res_model">account.move</field>
            <field name="view_mode">tree,form</field>
            <field name="view_id" ref="view_out_invoice_bill_tree_customer"/>
            <field name="search_view_id" ref="account.view_account_invoice_filter"/>
            <field name="domain">[('move_type', '=', 'out_invoice')]</field>
            <field name="context">{'default_move_type': 'out_invoice', 'test_move_type': 'out_invoice'}</field>
            <!--            ,'search_default_status':1,'search_default_payment_status':1-->
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Create a customer invoice
                </p>
                <p>
                    Create invoices, register payments and keep track of the discussions with your customers.
                </p>
            </field>
        </record>

        <record id="account.action_move_out_refund_type" model="ir.actions.act_window">
            <field name="view_id" ref="view_out_invoice_bill_tree_customer"/>
            <field name="view_mode">tree,form</field>
        </record>

        <record id="view_invoice_asset_category_inherit" model="ir.ui.view">
            <field name="name">account.move.form.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="om_account_asset.view_invoice_asset_category"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='asset_category_id']"
                       position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </xpath>
                <xpath expr="//field[@name='line_ids']/tree/field[@name='asset_category_id']" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </xpath>
            </field>
        </record>

        <record id="view_move_tree_inherit_by_accounting_extend" model="ir.ui.view">
            <field name="name">account.move.tree.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='amount_total_signed']" position="attributes">
                    <attribute name="sum" remove="Total Amount" separator=" "/>
                </xpath>
            </field>
        </record>

        <record id="action_import_move_lines_iml" model="ir.actions.client">
            <field name="name">Import Invoice lines</field>
            <field name="tag">import</field>
            <field name="params" eval="{
                'model': 'account.move.line',
                'import_template_label': 'Import Invoice Lines',
                'import_template_template': '/accounting_extend/static/Sample-XLS-File/revenue_code_invoice_line.xls',
                'allow_fields': ['revenue_product_id', 'account_id', 'analytic_distribution', 'quantity', 'name', 'price_unit']
            }"/>
        </record>

        <record id="action_import_bill_lines_iml" model="ir.actions.client">
            <field name="name">Import Bill lines</field>
            <field name="tag">import</field>
            <field name="params" eval="{
                'model': 'account.move.line',
                'import_template_label': 'Import Bill Lines',
                'import_template_template': '/accounting_extend/static/Sample-XLS-File/expense_code_invoice_line.xls',
                'allow_fields': ['product_id', 'account_id', 'analytic_distribution', 'quantity', 'name', 'price_unit']
            }"/>
        </record>

        <record id="view_account_move_form_view_inherit_inv_categ_line" model="ir.ui.view">
            <field name="name">account.move.form.inherit</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <xpath expr="//header" position="inside">
                    <!-- <button name="merged_all_pdf" string="Merge All PDF/Image" type="object"/> -->
                    <button name="%(action_import_move_lines_iml)d"
                            string="Import Invoice Lines"
                            type="action"
                            invisible="state != 'draft' or move_type not in ['out_invoice']"/>
                    <button name="%(action_import_bill_lines_iml)d"
                            string="Import Bill Lines"
                            type="action"
                            invisible="state != 'draft' or move_type not in ['in_invoice']"/>
                </xpath>
                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='account_id']" position="attributes">
                    <!-- Replace or update domain -->
                    <attribute name="domain">
                        [('deprecated', '=', False), ('company_id', 'parent_of', parent.company_id)]
                    </attribute>
                </xpath>
                <!-- Locate the warning div using class and remove it -->
                <xpath expr="//div[@class='oe_title']/div[@class='text-warning']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//group[@id='header_right_group']/field[@name='date']" position="attributes">
                    <attribute name="invisible">move_type == 'in_invoice'</attribute>
                    <attribute name="required">0</attribute>
                </xpath>
                <xpath expr="//field[@name='invoice_date']" position="attributes">
                    <attribute name="required">move_type == 'in_invoice'</attribute>
                </xpath>
                <xpath expr="//field[@name='narration']" position="attributes">
                    <attribute name="invisible">move_type != 'out_invoice'</attribute>
                </xpath>
                <xpath expr="//page[@id='other_tab_entry']//field[@name='narration']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//header" position="after">
                    <div
                            class="alert alert-warning" role="alert"
                            invisible="not message or move_type != 'out_invoice'">
                        <field name="message" readonly="1"/>
                    </div>
                </xpath>
                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="action_open_invoice_payment" type="object" string="Payment"
                            icon="fa-dollar" invisible="move_type == 'entry' or state == 'draft'"/>
                    <!-- <button name="action_open_vendor_bill_payment" type="object" string="Vendor Bill"
                            icon="fa-check" invisible="move_type != 'in_invoice'"/> -->
                </xpath>
                <xpath expr="//field[@name='fiscal_position_id']" position="replace"/>
                <!--                    <attribute name="invisible">1</attribute>-->
                <!--                </xpath>-->

                <label name="invoice_vendor_bill_id_label" position="attributes">
                    <attribute name="invisible">True</attribute>
                </label>
                <field name="invoice_outstanding_credits_debits_widget" position="attributes">
                    <attribute name="invisible">0</attribute>
                </field>

                <!-- <xpath expr="//button[@name=228]" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath> -->

                <xpath expr="//form/sheet" position="before">
                    <div groups="account.group_account_invoice,account.group_account_readonly"
                         class="alert alert-warning" role="alert"
                         invisible="display_attachment_warning==''">
                        <field name="display_attachment_warning"/>
                    </div>
                </xpath>
                <field name="invoice_vendor_bill_id" position="attributes">
                    <attribute name="invisible">True</attribute>
                </field>
                <!--                <field name="invoice_vendor_bill_id" position="attributes">-->
                <!--                    <attribute name="invisible">False</attribute>-->
                <!--                    <attribute name="placeholder">Select an old Entries</attribute>-->
                <!--                    <attribute name="domain">[('company_id', '=', company_id), ('partner_id','child_of', [partner_id]),-->
                <!--                        '|', '|', '|',-->
                <!--                        '&amp;', ('move_type', '=', 'in_invoice'), ('move_type', '=', context.get('default_move_type')),-->
                <!--                        '&amp;', ('move_type', '=', 'out_invoice'), ('move_type', '=',-->
                <!--                        context.get('default_move_type')),-->
                <!--                        '&amp;', ('move_type', '=', 'out_refund'), ('move_type', '=', context.get('default_move_type')),-->
                <!--                        '&amp;', ('move_type', '=', 'in_refund'), ('move_type', '=', context.get('default_move_type'))]-->
                <!--                    </attribute>-->
                <!--                </field>-->
                <xpath expr="//field[@name='invoice_date']" position="after">
                    <field name="show_invoice_delivery_address" invisible="1"/>
                </xpath>
                <xpath expr="//field[@name='partner_shipping_id']" position="attributes">
                    <attribute name="groups"></attribute>
                    <attribute name="invisible">move_type not in ('out_invoice', 'out_refund', 'out_receipt') or not
                        show_invoice_delivery_address
                    </attribute>
                </xpath>
                <xpath expr="//button[@name='action_post'][2]" position="attributes">
                    <attribute name="string">Post</attribute>
                </xpath>
                <xpath expr="//label[@for='journal_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <xpath expr="//div[@name='journal_div']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <!--			    <page name="aml_tab" position="attributes">-->
                <!--			        <attribute name="invisible">move_type in ['out_invoice','out_refund','in_invoice','in_refund']</attribute>-->
                <!--			    </page>-->
                <field name="partner_shipping_id" position="attributes">
                    <attribute name="invisible">1</attribute>
                </field>
                <field name="quick_edit_total_amount" position="attributes">
                    <attribute name="invisible">1</attribute>
                </field>
                <field name="date" position="attributes">
                    <attribute name="invisible">not quick_edit_mode and not (state == 'posted' and date !=
                        invoice_date)
                    </attribute>
                </field>
                <xpath expr="//label[@for='ref']" position="attributes">
                    <attribute name="string">Bill Description</attribute>
                </xpath>
                <xpath expr="//h1" position="replace">
                    <h1 invisible="context.get('default_move_type') in ('in_invoice','entry')">
                        <field name="name" invisible="context.get('default_move_type') in ('in_invoice')"
                               readonly="state != 'draft'" placeholder="Draft"/>
                        <span invisible="state != 'draft' or name != '/' or posted_before or quick_edit_mode">Draft
                        </span>
                    </h1>
                    <h1 invisible="context.get('default_move_type') not in ('in_invoice')">
                        <field name="vendor_bill_ref" invisible="context.get('default_move_type') not in ('in_invoice')"
                               readonly="state != 'draft'" placeholder="Vendor Bill No."
                               required="context.get('default_move_type') in ('in_invoice')"/>
                    </h1>
                    <h1 invisible="context.get('default_move_type') not in ('entry')">
                        <field name="name" invisible="context.get('is_name_not_show') and name=='/'"
                               readonly="state != 'draft'" placeholder="Draft"/>
                        <span invisible="state != 'draft' or name != '/' or posted_before or quick_edit_mode">Draft
                        </span>
                    </h1>
                </xpath>
                <xpath expr='//div[hasclass("oe_title")]/span[hasclass("o_form_label")]' position='replace'>
                    <span class="o_form_label">
                        <field name="move_type" readonly="1" nolabel="1"/>
                    </span>
                </xpath>
                <xpath expr="//field[@name='partner_bank_id']" position="attributes">
                    <attribute name="invisible">1</attribute>
                </xpath>
                <field name="fiscal_position_id" position="attributes">
                    <attribute name="invisible">context.get('default_move_type') in ('entry')</attribute>
                </field>

                <!--                <field name="ref" position="after">-->
                <!--                    <field name="vendor_bill_ref"-->
                <!--                           invisible="context.get('default_move_type') not in ('in_invoice', 'in_refund', 'in_receipt')"/>-->
                <!--                </field>-->
                <field name="invoice_incoterm_id" position="attributes">
                    <attribute name="invisible">1</attribute>
                </field>
                <field name="incoterm_location" position="attributes">
                    <attribute name="invisible">1</attribute>
                </field>

                <!--            <field name="fiscal_position_id" position="attributes">
                                    <attribute name="invisible"></attribute>
                                </field>
                 -->
                <xpath expr="//label[@for='partner_id']" position="attributes">
                    <attribute name="class">text-danger</attribute>
                </xpath>
                <xpath expr="//label[@for='partner_id'][1]" position="attributes">
                    <attribute name="class">text-danger</attribute>
                </xpath>

                <xpath expr="//field[@name='partner_id']" position="replace">

                    <field name="partner_id" string='Vendor' nolabel="1"
                           autocomplete="off"
                           context="{
                                            'res_partner_search_mode': (context.get('default_move_type', 'entry') in ('out_invoice', 'out_refund', 'out_receipt') and 'customer') or (context.get('default_move_type', 'entry') in ('in_invoice', 'in_refund', 'in_receipt') and 'supplier') or False,
                                            'show_address': 0, 'default_is_company': True, 'show_vat': True,'default_is_supplier': True, 'is_vendor_from_invoice':True}"
                           domain="[('company_id', 'in', (False, company_id)),('supplier_rank','>', 0),('parent_id','=',False),('is_supplier','=',True)]"
                           options='{"no_quick_create": True}'
                           required="1"
                           invisible="move_type not in ('in_invoice', 'in_refund', 'in_receipt')"
                           readonly="state != 'draft'"/>
                    <field name="partner_id" string='Customer' nolabel="1"
                           autocomplete="off"
                           context="{
                                            'res_partner_search_mode': (context.get('default_move_type', 'entry') in ('out_invoice', 'out_refund', 'out_receipt') and 'customer') or (context.get('default_move_type', 'entry') in ('in_invoice', 'in_refund', 'in_receipt') and 'supplier') or False,
                                            'show_address': 0, 'default_is_company': True, 'show_vat': True, 'default_is_customer': True, 'is_customer_from_invoice':True}"
                           domain="[('company_id', 'in', (False, company_id)),('customer_rank','>', 0),('parent_id','=',False),('is_customer','=',True)]"
                           options='{"no_quick_create": True}'
                           required="1"
                           invisible="move_type not in ('out_invoice', 'out_refund','out_receipt')"
                           readonly="state != 'draft'"/>
                </xpath>

                <field name="payment_reference" position="attributes">
                    <attribute name="invisible">1</attribute>
                </field>

                <xpath expr="//page[@name='other_info']//field[@name='ref']" position="replace"/>

                <xpath expr="//page[@name='other_info']//label[@for='ref']" position="replace"/>

                <field name="payment_reference" position="after">
                    <label for="ref" string="PO Number"
                           invisible="move_type not in ('out_invoice', 'out_receipt', 'out_refund')"/>
                    <field name="ref" nolabel="1"
                           required="is_po_ref_req and move_type in ('out_invoice', 'out_receipt', 'out_refund')"
                           invisible="move_type not in ('out_invoice', 'out_receipt', 'out_refund')"/>
                    <field name="is_po_ref_req" invisible="1"/>
                </field>
                <!--                <xpath expr="//field[@name='tax_totals']" position="before">-->
                <!--                    <label for="global_discount" string="Invoice Discount" class="total-amount custom-form-label"/>-->
                <!--                    <field name="global_discount" class="total-amount custom-form-label" nolabel="1"-->
                <!--                           invisible="move_type not in ('out_invoice', 'out_receipt', 'out_refund')"/>-->

                <!--                    <label for="total_without_global_discount" string="Total Without Invoice Discount"-->
                <!--                           class="total-amount custom-form-label"/>-->
                <!--                    <field name="total_without_global_discount" class="total-amount custom-form-label" nolabel="1"-->
                <!--                           invisible="move_type not in ('out_invoice', 'out_receipt', 'out_refund')"/>-->

                <!--                    <label for="discount_total" string="Discount Total" class="total-amount custom-form-label"/>-->
                <!--                    <field name="discount_total" class="total-amount custom-form-label" nolabel="1"-->
                <!--                           invisible="move_type not in ('out_invoice', 'out_receipt', 'out_refund')"/>-->
                <!--                </xpath>-->

                <field name="product_id" position="replace">
                    <!--                    <field name="move_type" optional="hide" readonly="1"/>-->
                    <field name="revenue_product_id" string="Revenue Codes" domain="[('sale_ok','=',True)]"
                           column_invisible="parent.move_type not in ['out_invoice', 'out_refund', 'out_receipt']"
                           context="{'search_default_filter_to_sell': 1, 'default_sale_ok':True, 'default_purchase_ok':False, 'default_sellable':True, 'default_purchasable':False, 'import_template_label': 'Import Template for Revenue Codes', 'import_template_template': '/accounting_extend/static/base_import_sample_file/sample_revenue_code.csv', 'allow_fields': ['name', 'default_code', 'list_price', 'categ_id', 'property_account_income_id']}"/>
                    <field name="product_id" string="Expense Codes" domain="[('purchase_ok','=',True)]"
                           column_invisible="parent.move_type not in ['in_invoice', 'in_refund', 'in_receipt']"
                           context="{'search_default_filter_to_purchase': 1, 'default_purchase_ok':True, 'default_sale_ok':False, 'default_sellable':False, 'default_purchasable':True, 'import_template_label': 'Import Template for Expense Codes', 'import_template_template': '/accounting_extend/static/base_import_sample_file/sample_expense_code.csv', 'allow_fields': ['name', 'default_code', 'list_price', 'standard_price', 'default_memo', 'categ_id', 'property_account_expense_id']}"/>
                </field>

                <xpath expr="//page[@name='invoice_tab']//tree//field[@name='name']" position="attributes">
                    <attribute name="string">Memo</attribute>
                </xpath>

                <xpath expr="//page[@name='invoice_tab']//tree//field[@name='price_subtotal']" position="replace">
                    <field name="price_subtotal" string="Tax excl." optional="hide"/>
                </xpath>

                <xpath expr="//field[@name='invoice_line_ids']/tree/field[@name='discount']" position="after">
                    <field name="discount_price" optional="hide"/>
                </xpath>
                <xpath expr="//field[@name='line_ids']//tree/field[@name='debit']" position="replace">
                    <field name="debit"/>
                </xpath>
                <xpath expr="//field[@name='line_ids']//tree/field[@name='credit']" position="replace">
                    <field name="credit"/>
                </xpath>
                <xpath expr="//field[@name='line_ids']" position="after">
                    <field name="related_journal_entry_ids" readonly="1" invisible="not related_journal_entry_ids">
                        <tree string="Related Payment Journal Entries" default_order="sequence, id">
                            <field string="Asset Category" name="asset_category_id" invisible="1" column_invisible="1"
                                   on_change="1" can_create="True" can_write="True"/>
                            <field name="account_id" invisible="display_type in ('line_section', 'line_note')"
                                   required="display_type not in ('line_section', 'line_note')"
                                   domain="[('company_id', 'parent_of', parent.company_id), ('deprecated', '=', False)]"
                                   on_change="1" can_create="True" can_write="True"/>
                            <field name="partner_id" optional="show"
                                   domain="['|', ('parent_id', '=', False), ('is_company', '=', True)]"
                                   column_invisible="parent.move_type != 'entry'" on_change="1" can_create="True"
                                   can_write="True"/>
                            <field name="name" widget="section_and_note_text" optional="show"/>
                            <field name="analytic_distribution" widget="analytic_distribution" optional="show"
                                   options="{'account_field': 'account_id'}"
                                   business_domain_compute="parent.move_type in ['out_invoice', 'out_refund', 'out_receipt'] and 'invoice' or parent.move_type in ['in_invoice', 'in_refund', 'in_receipt'] and 'bill' or 'general'"/>
                            <field name="date_maturity" optional="hide"
                                   invisible="display_type in ('line_section', 'line_note')"
                                   column_invisible="context.get('view_no_maturity')"/>
                            <field name="tax_ids" widget="autosave_many2many_tags" optional="hide"
                                   domain="[('type_tax_use', '=?', parent.invoice_filter_type_domain)]"
                                   context="{'append_type_to_tax_name': not parent.invoice_filter_type_domain, 'active_test': True}"
                                   options="{'no_create': True}" force_save="1"
                                   readonly="display_type in ('line_section', 'line_note') or tax_line_id or (parent.move_type in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt') and account_type in ('asset_receivable', 'liability_payable'))"
                                   on_change="1" can_create="True" can_write="True"/>
                            <field name="debit" sum="Total Debit"
                                   invisible="display_type in ('line_section', 'line_note')"
                                   readonly="parent.move_type in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt') and display_type in ('line_section', 'line_note', 'product')"
                                   on_change="1"/>
                            <field name="credit" sum="Total Credit"
                                   invisible="display_type in ('line_section', 'line_note')"
                                   readonly="parent.move_type in ('out_invoice', 'out_refund', 'in_invoice', 'in_refund', 'out_receipt', 'in_receipt') and display_type in ('line_section', 'line_note', 'product')"
                                   on_change="1"/>
                            <field name="balance" column_invisible="True" on_change="1"/>
                            <field name="discount_date" string="Discount Date" optional="hide"/>
                            <field name="discount_amount_currency" string="Discount Amount" optional="hide"/>

                            <field name="tax_tag_ids" widget="many2many_tags" string="Tax Grids" optional="show"
                                   options="{'no_create': True}"
                                   domain="[                                                     ('applicability', '=', 'taxes'),                                                     '|', ('country_id', '=', parent.tax_country_id),                                                     ('country_id', '=', False),                                                 ]"
                                   on_change="1" can_create="True" can_write="True"/>

                            <field name="tax_tag_invert" readonly="1" optional="hide"/>

                            <!-- Buttons -->
                            <button name="action_automatic_entry" type="object" icon="fa-calendar" string="Cut-Off"
                                    aria-label="Change Period" class="float-end"
                                    column_invisible="parent.move_type == 'entry' or parent.state != 'posted'"
                                    invisible="account_internal_group not in ('income', 'expense')"
                                    context="{'default_action': 'change_period'}"/>

                            <!-- Others fields -->
                            <field name="tax_line_id" column_invisible="True" on_change="1"/>
                            <field name="company_currency_id" column_invisible="True"/>
                            <field name="display_type" force_save="1" column_invisible="True" on_change="1"/>
                            <field name="company_id" column_invisible="True" on_change="1"/>
                            <field name="sequence" column_invisible="True"/>
                            <field name="id" column_invisible="True"/>
                            <field name="account_internal_group" column_invisible="True"/>
                            <field name="account_type" column_invisible="True"/>
                        </tree>
                    </field>
                </xpath>
                <!-- <xpath expr="//div[hasclass('o_attachment_preview')]" position="replace"/> -->
            </field>
        </record>

