<?xml version="1.0" encoding="utf-8"?>
<odoo>

	<data>
		<record id="view_partner_bank_form_inherit_account" model="ir.ui.view">
			<field name="name">res.partner.bank.form</field>
			<field name="model">res.partner.bank</field>
			<field name="inherit_id" ref="base.view_partner_bank_form"/>
			<field name="arch" type="xml">
				<field name="acc_number" position="attributes">
					<attribute name="invisible">0</attribute>
					<attribute name="required">1</attribute>
					<attribute name="groups">base.group_system,!accounting_extend.group_restrict_accounting_details</attribute>
				</field>
				<field name="allow_out_payment" position="attributes">
					<attribute name="string">Verified</attribute>
					<attribute name="widget">boolean</attribute>
				</field>
<!--				<field name="aba_routing" position="attributes">-->
<!--					<attribute name="invisible">1</attribute>-->
<!--				</field>-->
			    <field name="allow_out_payment" position="after">
<!--					<field name="acc_number" required="payment_method_type == 'direct_deposit'"-->
<!--						   invisible="payment_method_type != 'direct_deposit'"-->
<!--						   groups="base.group_system,!accounting_extend.group_restrict_accounting_details"/>-->
					<!-- <field name="acc_number"
						   groups="base.group_system,!accounting_extend.group_restrict_accounting_details"/> -->
					<field name="void_check_att_ids" widget="many2many_binary" string="Upload Attachments"/>
					<field name="active_bank"  string="Active" required="1" force_save="1"/>
				</field>
<!--			    <field name="acc_number" position="attributes">-->
<!--			    	<attribute name="required">payment_method_type == 'direct_deposit'</attribute>-->
<!--			    	<attribute name="invisible">payment_method_type != 'direct_deposit'</attribute>-->
<!--			    	<attribute name="groups">!accounting_extend.group_restrict_accounting_details</attribute>-->
<!--			    </field>-->
				<field name="bank_id" position="before">
			        <field name="payment_method_type" required="context.get('res_partner_search_mode') in ['supplier','customer']" invisible="context.get('res_partner_search_mode') == 'supplier'"
					/>
<!--					<field name="routing_number" invisible="payment_method_type == 'credit_card'" required="payment_method_type != 'credit_card'"/>-->
<!--			        <field name="acc_number" required="1" invisible="payment_method_type != 'credit_card'" groups="!accounting_extend.group_restrict_accounting_details" string="Credit Card Number"/>-->
<!--			        <field name="credit_card_att" required="payment_method_type == 'credit_card'" invisible="payment_method_type != 'credit_card'"/>-->
			        <field name="masked_acc_number" required="1" invisible="payment_method_type != 'direct_deposit'" groups="accounting_extend.group_restrict_accounting_details"/>
			        <field name="masked_acc_number" required="1" invisible="payment_method_type != 'credit_card'" groups="accounting_extend.group_restrict_accounting_details" string="Credit Card Number"/>
			    </field>
<!--			    <field name="bank_id" position="attributes">-->
<!--			    	<attribute name="invisible">payment_method_type != 'direct_deposit'</attribute>-->
<!--			    </field>-->
				<field name="bank_id" position="replace">
					<field name="bank_name" required="1"/>
					<field name="bank_id" invisible="1"/>
				</field>
				 <field name="partner_id" position="attributes">
				 	<attribute name="required">1</attribute>
					<attribute name="invisible">context.get('res_partner_search_mode') in ['supplier', 'customer'] or payment_method_type == 'credit_card'</attribute>
				 </field>
<!--				 <field name="bank_id" position="after">-->
<!--					 <field name="routing_number" invisible="payment_method_type == 'credit_card'" readonly="1" required="payment_method_type != 'credit_card'"/>-->
<!--				 </field>-->
<!--				<field name="bank_id" position="after">-->
<!--					 <field name="routing_number" invisible="payment_method_type == 'credit_card'" readonly="1" required="payment_method_type != 'credit_card'"/>-->
<!--				 </field>-->
				<field name="bank_id" position="after">
					 <field name="routing_number" required="1"/>
				 </field>
				 <field name="acc_holder_name" position="attributes">
					<!--  <attribute name="invisible">context.get('res_partner_search_mode') in ['supplier', 'customer'] or payment_method_type == 'credit_card'</attribute> -->
					<attribute name="invisible">1</attribute>
				 </field>
<!--			    <xpath expr="//group[1]" position="after">-->
<!--			    	<group>-->
<!--                        <field name="authorize_signature" widget="signature" invisible="payment_method_type != 'credit_card'"/>-->
<!--                    </group>-->
<!--			    </xpath>-->
				<field name="partner_id" position="after">
						<label for="street" string="Bank Address"/>
						<div class="o_address_format">
							<field name="street" placeholder="Street..." class="o_address_street"/>
							<field name="street2" placeholder="Street 2..." class="o_address_street"/>
							<field name="city" placeholder="City" class="o_address_city"/>
							<field name="state" class="o_address_state" placeholder="State"
								   options="{&quot;no_open&quot;: True}"/>
							<field name="zip" placeholder="ZIP" class="o_address_zip"/>
							<field name="country" placeholder="Country" class="o_address_country"
								   options="{&quot;no_open&quot;: True, &quot;no_create&quot;: True}"/>
						</div>
				</field>
			</field>
		</record>
