<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_users_form_accounting_extend" model="ir.ui.view">
        <field name="model">res.users</field>
        <field name="inherit_id" ref="mail.view_users_form_mail"/>
        <field name="arch" type="xml">
            <field name="notification_type" position="attributes">
                <attribute name="invisible">True</attribute>
            </field>
        </field>
    </record>
      <record id="view_users_form_accounting_extend_user_from" model="ir.ui.view">
        <field name="model">res.users</field>
        <field name="inherit_id" ref="mail.view_users_form_simple_modif_mail"/>
        <field name="arch" type="xml">
            <field name="notification_type" position="attributes">
                <attribute name="invisible">True</attribute>
            </field>
        </field>
    </record>


        <record id="view_users_form_custom" model="ir.ui.view">
            <field name="name">res.users.form.inherit</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form"/>
            <field name="arch" type="xml">
                <!-- Set default language -->
                <xpath expr="//field[@name='lang']" position="attributes">
                    <attribute name="default">en_US</attribute>
                </xpath>
            </field>
        </record>

    <record model="ir.ui.view" id="view_totp_field_inherit_account_extend">
        <field name="name">users preference: hide totp Accounting Extend</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="auth_totp.view_totp_form"/>
        <field name="arch" type="xml">
            <!-- Target the group containing the TOTP section and hide it -->
            <xpath expr="//page[@name='security']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="auth_totp.view_totp_field" model="ir.ui.view">
        <field name="active">False</field>
    </record>

    <record id="view_users_form_accounting_extend_user_from_base" model="ir.ui.view">
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='access']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
              <xpath expr="//notebook//page[2]//group[3]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>



</odoo>
