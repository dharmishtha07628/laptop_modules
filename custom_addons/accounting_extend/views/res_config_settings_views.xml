                                    </div>
                                </div>
                            </setting>
                            <setting id="post_bank_transactions_and_payments_setting"
                                     string="Post bank transactions and payments in:"
                                     groups="accounting_extend.default_account_visible"
                            >
                                <div class="content-group">
                                    <div class="row mt8">
                                        <label for="account_journal_suspense_account_id"
                                               class="col-lg-5 o_light_label"/>
                                        <field name="account_journal_suspense_account_id"/>
                                    </div>
                                    <div class="row mt8">
