        <record id="res_config_settings_view_form_for_normal_users" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.accounting.extend</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="85"/>
            <field name="inherit_id" ref="account.res_config_settings_view_form"/>
