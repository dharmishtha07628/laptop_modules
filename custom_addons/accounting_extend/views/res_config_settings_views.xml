                        <block title="Default Accounts" id="default_accounts">
                            <!--                            invisible="not group_multi_currency"-->
                            <setting string="Post Exchange difference entries in:"
                                     groups="accounting_extend.default_account_visible"
                            >
                                <div class="content-group">
                                    <div class="row mt8">
                                        <label for="currency_exchange_journal_id" class="col-lg-4 o_light_label"
