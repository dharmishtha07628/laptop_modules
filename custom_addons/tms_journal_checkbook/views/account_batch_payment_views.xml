<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="inherit_account_batch_payment_for_check_print_form" model="ir.ui.view">
        <field name="name">account.batch.payment.form.for.check.print</field>
        <field name="model">account.batch.payment</field>
        <field name="inherit_id" ref="account_batch_payment.view_batch_payment_form"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="check_ids" invisible="1"/>
            </field>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="check_history_action" type="object" string="Check" icon="fa-money" widget="statinfo" groups="account.group_account_manager" invisible="not check_ids"/>
            </xpath>
        </field>
    </record>

</odoo>
