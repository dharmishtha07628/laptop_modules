<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="tms_inherit_view_account_payment_form" model="ir.ui.view">
        <field name="name">account.payment.form.for.check.print</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <!-- <button name="action_draft" position="attributes">
                <attribute name="invisible">1</attribute>
            </button> -->
            <field name="is_move_sent" position="after">
                <field name="check_history_id" invisible="1"/>
            </field>
            <xpath expr="//button[@name='action_post']" position="attributes">
                <attribute name="context">{
                    'is_pay_bill': True
                }</attribute>
            </xpath>
             <xpath expr="//div[@name='button_box']" position="inside">
                <button name="check_history_action" type="object" string="Check" icon="fa-money" widget="statinfo" groups="account.group_account_manager" invisible="not check_history_id"/>
            </xpath>
        </field>
    </record>

</odoo>
