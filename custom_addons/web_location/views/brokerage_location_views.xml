<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_brokerage_location_form_inherited_by_web_location" model="ir.ui.view">
        <field name="name">brokerage.location.form</field>
        <field name="model">brokerage.location</field>
        <field name="inherit_id" ref="freight_brokerage.view_brokerage_location_form"/>
        <field name="arch" type="xml">

            <field name="address" position="attributes">
                <attribute name="widget">at_address_auto_complete</attribute>
            </field>
            <xpath expr='//field[@name="address"]' position='before'>
                <field name="at_contact_google_location"
                       placeholder="Street..." widget="at_address_auto_complete" class="o_address_street" invisible="1"/>
            </xpath>

            <field name="location_rating" position="after">
				<field name="at_contact_place_text" style="visibility: hidden;" nolabel="1"/>
				<field name="at_contact_place_text_main_string" style="visibility: hidden;" nolabel="1"/>
			</field>

        </field>
    </record>

</odoo>