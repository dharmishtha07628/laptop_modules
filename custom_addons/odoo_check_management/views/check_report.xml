<odoo>
    <data>
        <template id="bank_check_print_pdf_report">
            <t t-call="web.basic_layout">
                <t t-foreach="docs" t-as="o">
                    <div>
                        <img style="width: 100%" t-attf-src="/website/image/res.bank/{{o.id}}/check_image/"/>
                        <div style="margin: 0px">
                            <t t-foreach="o.check_attribute_line_ids" t-as="bank_check_line_obj">
                                <div t-attf-style='
                                    position: absolute;
                                    top: #{str(bank_check_line_obj.top_displacement-6 + 2 if bank_check_line_obj.name.attribute in ["check_date"] else bank_check_line_obj.top_displacement-6) + "pt"};
                                    left: #{str(bank_check_line_obj.left_displacement-8 - 2 if bank_check_line_obj.name.attribute in ["check_date"] else bank_check_line_obj.left_displacement-8)  + "pt"};
                                    height: #{str(bank_check_line_obj.height) + "pt"};
                                    width: #{str(bank_check_line_obj.width) + "pt"};
                                    font-size: #{str(bank_check_line_obj.font_size) + "px" if bank_check_line_obj.font_size else "20px"};
                                    margin-top:00pt;
                                    letter-spacing: #{str(bank_check_line_obj.letter_spacing) + "px"};
                                    '>
                                    <t t-if="bank_check_line_obj.name.attribute != 'check_date'" t-esc="bank_check_line_obj.name.demo_data"/>
                                    <span t-if="bank_check_line_obj.name.attribute == 'check_date' and bank_check_line_obj.name.date_format == 'ddMMyyyy'" t-field="bank_check_line_obj.name.demo_data_date" t-options='{"format": "ddMMyyyy"}'></span>
                                    <span t-if="bank_check_line_obj.name.attribute == 'check_date' and bank_check_line_obj.name.date_format == 'MMddyyyy'" t-field="bank_check_line_obj.name.demo_data_date" t-options='{"format": "MMddyyyy"}'></span>
                                </div>
                                <t t-if="bank_check_line_obj.name.attribute == 'ac_pay'">
                                    <div t-if="not (bank_check_line_obj.top_displacement and bank_check_line_obj.left_displacement and bank_check_line_obj.height and bank_check_line_obj.width)" t-attf-style='position: absolute;
                                        top: 0px;
                                        left: -20px;
                                        width: 125px;
                                        margin-top: 14pt;
                                        letter-spacing: #{str(bank_check_line_obj.letter_spacing) + "px"};
                                        border-top: 1px solid black;
                                        border-bottom: 1px solid black;
                                        -webkit-backface-visibility: hidden;
                                        -webkit-transform: rotate(-40deg);
                                        text-align: center;'>
                                        A/C Pay
                                    </div>
                                    <div t-else="" t-attf-style='position: absolute;
                                        top: #{str(bank_check_line_obj.top_displacement-6) + "pt"};
                                        left: #{str(bank_check_line_obj.left_displacement-8) + "pt"};
                                        font-size: #{str(bank_check_line_obj.font_size) + "px" if bank_check_line_obj.font_size else "20px"};
                                        margin-top:00pt;
                                        border-top: 1px solid black;
                                        letter-spacing: #{str(bank_check_line_obj.letter_spacing) + "px"};
                                        border-bottom: 1px solid black;
                                        padding: 5px;'>A/C Pay
                                    </div>
                                </t>
                            </t>
                        </div>
                    </div>
                </t>
            </t>
        </template>

        <record id="bank_check_paperformat" model="report.paperformat">
            <field name="name">Bank Check Print Paper Format</field>
            <field name="default" eval="False"/>
            <field name="margin_top">00</field>
            <field name="margin_bottom">00</field>
            <field name="margin_left">00</field>
            <field name="margin_right">00</field>
            <field name="header_spacing">00</field>
            <field name="orientation">Portrait</field>
        </record>

        <record id="bank_check_print_report" model="ir.actions.report">
            <field name="name">Check Preview</field>
            <field name="model">res.bank</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">odoo_check_management.bank_check_print_pdf_report</field>
            <field name="report_file">odoo_check_management.bank_check_print_pdf_report</field>
            <field name="print_report_name">object.name</field>
            <field name="paperformat_id" ref="odoo_check_management.bank_check_paperformat"/>
            <field name="binding_type">report</field>
        </record>

        <template id="bank_check_history_print_pdf_report">
            <t t-call="web.basic_layout">
                <style type="text/css">
                    @font-face {
                    font-family: 'OpenSans';
                    src: url('/odoo_check_management/static/font/open-sans.regular.ttf') format('truetype');
                    }
                    .OpenSans {
                    font-family: 'OpenSans';
                    letter-spacing: 2px;
                    font-size: 12px;
                    }
                </style>
                <t t-foreach="docs" t-as="o">
                    <div class="page OpenSans" style="margin: 0px; padding: 0px; width: 100%; height: 100%;">
                    <t t-set="check_leaf_obj" t-value="o.check_history_id"/>
                    <t t-set="check_date" t-value="o.date"/>
<!--                    <t t-set="check_date" t-value="formatLang(o.date, date=True)"/>-->
                    <t t-set="pay_line1" t-value="o.pay_name_line1"/>
                    <t t-set="pay_line2" t-value="o.pay_name_line2"/>
                    <t t-set="amount_line_1" t-value="o.amount_in_words"/>
                    <t t-set="amount_line_2" t-value="o.amount_in_words_line2"/>
                    <t t-set="amount_box" t-value="o.amount"/>
                    <t t-set="account_number" t-value="o.check_book_id.account_number"/>
                    <t t-set="currency_id" t-value="o.currency_id"/>
                    <div t-if="check_leaf_obj" style="margin: 0px -15px 0px -15px;">
                        <img t-if="o.is_preview" style="width: 100%" t-attf-src="/website/image/res.bank/{{check_leaf_obj.bank_check_book_id.bank_check_id.id}}/check_image/"/>
                        <div>
                            <t t-foreach="check_leaf_obj.bank_check_book_id.bank_check_id.check_attribute_line_ids" t-as="bank_check_line_obj">
                                <div t-attf-style='
                                    position: absolute;
                                    top: #{str(bank_check_line_obj.top_displacement-6 + 2 if bank_check_line_obj.name.attribute in ["check_date"] else bank_check_line_obj.top_displacement-6) + "pt"};
                                    left: #{str(bank_check_line_obj.left_displacement-8 - 2 if bank_check_line_obj.name.attribute in ["check_date"] else bank_check_line_obj.left_displacement-8)  + "pt"};
                                    height: #{str(bank_check_line_obj.height) + "pt"};
                                    width: #{str(bank_check_line_obj.width) + "pt"};
                                    font-size: #{str(bank_check_line_obj.font_size) + "px" if bank_check_line_obj.font_size else "20px"};
                                    margin-top:00pt;
                                    letter-spacing: #{str(bank_check_line_obj.letter_spacing) + "px"};'>
<!--                                    <span t-if="bank_check_line_obj.name.attribute == 'check_date' and bank_check_line_obj.name.date_format == 'ddMMyyyy'" t-field="o.date" t-options='{"format": "ddMMyyyy"}'></span>-->
                                    <span t-if="bank_check_line_obj.name.attribute == 'check_date'"
                                          t-esc="o.date.strftime('%B %d, %Y') if o.date else ''"/>
                                    <span t-if="bank_check_line_obj.name.attribute == 'check_date' and bank_check_line_obj.name.date_format == 'MMddyyyy'" t-field="o.date" t-options='{"format": "MMddyyyy"}'></span>
                                    <t t-if="bank_check_line_obj.name.attribute == 'pay_line1'" t-esc="pay_line1"/>
                                    <t t-if="bank_check_line_obj.name.attribute == 'pay_line2'" t-esc="pay_line2"/>
<!--                                    <t t-if="bank_check_line_obj.name.attribute == 'amount_line_1'" t-esc="amount_line_1"/>-->
                                    <t t-if="bank_check_line_obj.name.attribute == 'amount_line_2'" t-esc="amount_line_2"/>
                                     <t t-if="bank_check_line_obj.name.attribute == 'amount_line_1'">
                                         *** <t t-esc="amount_line_1"/> ***
                                    </t>
                                    <t t-if="bank_check_line_obj.name.attribute == 'amount_box'" t-raw="'${:,.2f}'.format(amount_box)"/>
                                    <t t-if="bank_check_line_obj.name.attribute == 'account_number'" t-esc="account_number"/>
                                    <t t-if="bank_check_line_obj.name.attribute == 'check_number'" t-esc="check_number"/>
                                    <t t-if="bank_check_line_obj.name.attribute == 'address'" t-esc="address"/>
                                </div>
<!--                                <t t-if="bank_check_line_obj.name.attribute == 'ac_pay'">-->
<!--                                    <div t-if="not (bank_check_line_obj.top_displacement and bank_check_line_obj.left_displacement and bank_check_line_obj.height and bank_check_line_obj.width)" t-attf-style="position: absolute;top: 0px;    left: -20px;width: 125px;margin-top: 14pt;letter-spacing:#{str(bank_check_line_obj.letter_spacing) + 'px'};border-top: 1px solid black;border-bottom: 1px solid black;-webkit-backface-visibility: hidden;-webkit-transform: rotate(-40deg);text-align: center;">A/C Pay</div>-->
<!--                                    <div t-else="" t-attf-style='position: absolute;-->
<!--                                        top: #{str(bank_check_line_obj.top_displacement-6) + "pt"};-->
<!--                                        left: #{str(bank_check_line_obj.left_displacement-8) + "pt"};-->
<!--                                        font-size: #{str(bank_check_line_obj.font_size) + "px" if bank_check_line_obj.font_size else "20px"};-->
<!--                                        margin-top:00pt;-->
<!--                                        border-top: 1px solid black;-->
<!--                                        border-bottom: 1px solid black;-->
<!--                                        letter-spacing: #{str(bank_check_line_obj.letter_spacing) + "px"};-->
<!--                                        padding: 5px;'>A/C Pay-->
<!--                                    </div>-->
<!--                                </t>-->
                            </t>
                        </div>
                    </div>
                     </div>
                </t>
            </t>
        </template>

        <record id="bank_check_leaf_print_report" model="ir.actions.report">
            <field name="name">Check Print</field>
            <field name="model">invoice.print.bank.check.wizard</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">odoo_check_management.bank_check_history_print_pdf_report</field>
            <field name="report_file">odoo_check_management.bank_check_history_print_pdf_report</field>
            <field name="print_report_name">object.pay_name_line1</field>
            <field name="paperformat_id" ref="odoo_check_management.bank_check_paperformat"/>
            <field name="binding_type">report</field>
        </record>
    </data>
</odoo>
