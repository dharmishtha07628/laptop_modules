<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <record id="tms_setting_tree" model="ir.ui.view">
            <field name="name">tms.setting.tree</field>
            <field name="model">tms.setting</field>
            <field name="arch" type='xml'>
                <tree string="Report Models">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="tag_id"/>
                    <field name="description"/>
                </tree>
            </field>
        </record>

        <record id="tms_setting_form" model="ir.ui.view">
            <field name="name">tms.setting.form</field>
            <field name="model">tms.setting</field>
            <field name="arch" type='xml'>
                <form string="Report Models">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="tag_id"/>
                            </group>
                            <group>
                                <field name="description"/>
                            </group>
                        </group>

                        <notebook>
                            <page string="TMS Menus" name="tms_menus">
                                <field name="tms_menu_ids">
                                    <tree string="TMS Menus" editable="bottom">
                                        <field name="sequence" widget="handle"/>
                                        <field name="action_id"/>
                                        <field name="client_action_id"/>
                                        <field name="description"/>
                                    </tree>
                                </field>
                            </page>
                        </notebook>

                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids" widget="mail_followers"/>
                        <field name="message_ids" widget="mail_thread"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="tms_setting_search" model="ir.ui.view">
            <field name="name">tms.setting.search</field>
            <field name="model">tms.setting</field>
            <field name="arch" type="xml">
                <search string="TMS Setting">
                    <field name="name"/>
                    <field name="tag_id"/>
                    <group string="Group By">
                        <filter string="Tag" name="group_by_tag_id" domain="[]" context="{'group_by':'tag_id'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record model="ir.actions.act_window" id="tms_setting_action">
            <field name="name">TMS Settings</field>
            <field name="res_model">tms.setting</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'search_default_group_by_tag_id':1}</field>
        </record>


<!--        <menuitem id="menu_tms_settings" name="TMS Settings" action="tms_setting_action"-->
<!--                  parent="accounting_extend.menu_for_user_and_companies"-->
<!--                  active="False"/>-->
        <!--        parent="base.menu_users" -->

    </data>
</odoo>
