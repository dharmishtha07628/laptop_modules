<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>

        <record id="view_sophtron_api_transactions_form" model="ir.ui.view">
            <field name="name">Fetch Transactions</field>
            <field name="model">sophtron.api.transactions</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                    </group>
                    <footer>
                        <button string="Fetch" name="button_fetch_transactions" class="oe_highlight" type="object"/>

                        <button name="cancel" string="Cancel" class="oe_link" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>