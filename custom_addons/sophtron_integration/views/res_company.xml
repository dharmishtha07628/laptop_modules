<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_company_form_inherit_sophtron" model="ir.ui.view">
        <field name="name">view_company_form_inherit_sophtron.form</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Sophtorn">
                    <group>
                        <field name="sophtron_env"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>


</odoo>
