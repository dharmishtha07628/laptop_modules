<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_edi_order_reference_tree" model="ir.ui.view">
        <field name="name">edi.order.reference.tree</field>
        <field name="model">edi.order.reference</field>
        <field name="arch" type="xml">
            <tree string="EDI Order References">
                <field name="reference_identification"/>
                <field name="reference_ident_qualifier"/>
            </tree>
        </field>
    </record>

    <record id="view_edi_order_reference_form" model="ir.ui.view">
        <field name="name">edi.order.reference.form</field>
        <field name="model">edi.order.reference</field>
        <field name="arch" type="xml">
            <form string="EDI Order Reference">
                <sheet>
                    <group>
                        <group string="L11">
                            <field name="reference_identification"/>
                            <field name="reference_ident_qualifier"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
