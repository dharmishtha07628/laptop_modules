<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_edi_order_stops_tree" model="ir.ui.view">
        <field name="name">edi.order.stops.tree</field>
        <field name="model">edi.order.stops</field>
        <field name="arch" type="xml">
            <tree string="EDI Order Stops">
                <field name="stop_sequence_number"/>
                <field name="stop_reason_code"/>
                <field name="weight"/>
                <field name="weight_unit_code"/>
                <field name="number_of_units_shipped"/>
                <field name="volume"/>
                <field name="volume_unit_qualifier"/>
                <field name="reference_identification"/>
                <field name="quantity_of_pallet_ship"/>
                <field name="earliest_date"/>
                <field name="earliest_time"/>
            </tree>
        </field>
    </record>

    <record id="view_edi_order_stops_form" model="ir.ui.view">
        <field name="name">edi.order.stops.form</field>
        <field name="model">edi.order.stops</field>
        <field name="arch" type="xml">
            <form string="EDI Order Stop">
                <sheet>
                    <group>
                        <group string="S5">
                            <field name="stop_sequence_number"/>
                            <field name="stop_reason_code"/>
                            <field name="weight"/>
                            <field name="weight_unit_code"/>
                            <field name="number_of_units_shipped"/>
                            <field name="unit_or_basic_for_measurement_code"/>
                            <field name="volume"/>
                            <field name="volume_unit_qualifier"/>
                        </group>
                        <group string="L11D">
                            <field name="reference_identification"/>
                            <field name="reference_indent_qualifier"/>
                            <field name="description"/>
                        </group>

                        <group string="G62D">
                            <field name="earliest_date_time_qualifier"/>
                            <field name="earliest_date"/>
                            <field name="earliest_time_qualifier"/>
                            <field name="earliest_time"/>
                        </group>

                        <group string="G62L">
                            <field name="latest_date_time_qualifier"/>
                            <field name="latest_date"/>
                            <field name="latest_time_qualifier"/>
                            <field name="latest_time"/>
                        </group>
                        <group string="PLD (Pallet Information)">
                            <field name="quantity_of_pallet_ship"/>
                        </group>
                        <group string="Location">
                            <field name="edi_location_id"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Stop Details">
                            <field name="edi_stop_detail_ids">
                                <tree editable="bottom">
                                    <field name="reference_identification"/>
                                    <field name="division_code"/>
                                    <field name="purchase_order_number"/>
                                    <field name="delivery_order_id"/>
                                    <field name="unit_measurement_code"/>
                                    <field name="quantity"/>
                                    <field name="weight_unit_code"/>
                                    <field name="weight"/>
                                    <field name="volume_unit_qualifier"/>
                                    <field name="volume"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

</odoo>
