<odoo>
    <record id="view_retained_earnings_wizard_form" model="ir.ui.view">
        <field name="name">retained.earnings.wizard.form</field>
        <field name="model">retained.earnings.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Retained Earnings">
                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button name="action_generate_retained_earnings" type="object" string="Create Retained Earnings"
                            class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_retained_earnings_wizard" model="ir.actions.act_window">
        <field name="name">Generate Retained Earnings</field>
        <field name="res_model">retained.earnings.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_retained_earnings_wizard"
              name="Generate Retained Earnings"
              parent="account.menu_finance_reports"
              action="action_retained_earnings_wizard"
              sequence="10"/>

</odoo>
