<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="account_move_view_form_hide_tax_grid" model="ir.ui.view">
        <field name="name">account.move.form.inherit.hide.tax.grid</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@id='aml_tab']/field[@name='line_ids']/tree//field[@name='tax_tag_ids']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>
     <record id="closing_journal_field_add" model="ir.ui.view">
        <field name="name">account.journal.Reatined</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <field name="is_closing_journal" class="oe_inline" invisible="1"/>
            </xpath>
        </field>
     </record>
</odoo>