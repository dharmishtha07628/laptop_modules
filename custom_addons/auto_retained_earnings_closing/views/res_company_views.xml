<odoo>
    <record id="view_company_form_retained_earnings" model="ir.ui.view">
        <field name="name">res.company.retained.earnings</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='currency_id']" position="after">
                <group string="Year-End Settings">
                    <field name="account_retained_earnings_id"/>
                    <field name="account_current_year_earnings_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
