<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_custom_account_form" model="ir.ui.view">
        <field name="name">custom.account.form</field>
        <field name="model">custom.account</field>
        <field name="arch" type="xml">
            <form string="Custom Account">
                <sheet>
                    <div>
                        <h1 style="font-size: 1.9rem;">
                            <div class="row">
                                <div class="col col-md-auto">
                                    <label for="code" string="Code"/>
                                    <div>
                                        <field name="code" placeholder="e.g. 101000" class="oe_inline"/>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col col-md-8">
                                    <label for="name" string="Account Name"/>
                                    <div>
                                        <field name="name" placeholder="e.g. Current Assets"
                                               style="width:80% !important;"/>
                                    </div>
                                </div>
                            </div>
                        </h1>
                    </div>
                    <notebook>
                        <page name="accounting" string="Accounting">
                            <group>


                                <group>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="account_type"/>
                                    <field name="note"/>
                                    <field name="cash_flow_category"/>
                                    <field name="default_account" readonly="0"/>
                                </group>
                                <group>
<!--                                    <field name="deprecated"/>-->
                                    <field name="company_ids" widget="many2many_tags"/>
                                    <field name="account_ids" invisible="1"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                    <group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_custom_account_tree" model="ir.ui.view">
        <field name="name">custom.account.tree</field>
        <field name="model">custom.account</field>
        <field name="arch" type="xml">
            <tree>
                <field name="code"/>
                <field name="name"/>
                <field name="account_type"/>
                <field name="reconcile" widget="boolean_toggle"
                       invisible="account_type in ('asset_cash', 'liability_credit_card')"/>
                <field name="company_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>
    <record id="view_custom_account_search" model="ir.ui.view">
        <field name="name">custom.account.search</field>
        <field name="model">custom.account</field>
        <field name="arch" type="xml">
            <search string="Search Custom Accounts">
                <!-- Basic Filters -->
                <field name="name"/>
                <field name="code"/>
                <field name="account_type"/>

                <!-- Default Filters -->
                <filter string="Has Default Account" name="default_account"
                        domain="[('default_account', '=', True)]"/>

                <!-- Group By Options -->
                <group expand="0" string="Group By">
                    <filter string="Account Type" name="group_by_account_type" context="{'group_by': 'account_type'}"/>
                    <filter string="Company" name="group_by_company" context="{'group_by': 'company_ids'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_custom_account" model="ir.actions.act_window">
        <field name="name">Chart of Accounts</field>
        <field name="res_model">custom.account</field>
         <field name="search_view_id" ref="view_custom_account_search"/>
        <field name="view_mode">tree,form</field>
    </record>

    <!--    <menuitem id="menu_custom_account_root_01" name="Custom Accounting" />-->
    <!--    <menuitem id="menu_custom_account" name="Accounts" parent="menu_custom_account_root_01" action="action_custom_account"/>-->
    <record id="tms_setting_menu_chart_of_accounts_custom" model="tms.setting.menu">
        <field name="action_id" ref="tms_chart_of_accounts.action_custom_account"/>
        <field name="tms_setting_id" ref="tms_settings.tms_setting_accounting"/>
    </record>
</odoo>
