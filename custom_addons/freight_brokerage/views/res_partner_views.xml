<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="action_freight_contacts" model="ir.actions.act_window">
        <field name="name">Customer</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="base.view_res_partner_filter"/>
        <field name="context">{'default_partner_type': 'brokerage_customer', 'default_is_company': True}</field>
        <field name="domain">[('partner_type', '=', 'brokerage_customer'), ('is_customer','=',True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a Brokerage Customer in your address book
            </p>
            <p>
                It helps you track all activities related to your Brokerage Customers.
            </p>
        </field>
    </record>

    <menuitem id="brokerage_customer_menu" name="Customer" parent="freight_brokerage.brokerage_menu" action="action_freight_contacts"/>

</odoo>
