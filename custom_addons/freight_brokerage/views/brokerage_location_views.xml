<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_brokerage_location_tree" model="ir.ui.view">
        <field name="name">brokerage.location.tree</field>
        <field name="model">brokerage.location</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" string="Location Name"/>
                <field name="location_code" string="Short Code"/>
                <field name="address"/>
                <field name="city"/>
                <field name="state"/>
                <field name="zip_code"/>
                <field name="phone"/>
                <field name="location_rating"/>
            </tree>
        </field>
    </record>

    <record id="view_brokerage_location_form" model="ir.ui.view">
        <field name="name">brokerage.location.form</field>
        <field name="model">brokerage.location</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="location_code"/>
                            <field name="address"/>
                            <field name="city"/>
                            <field name="state"/>
                            <field name="zip_code"/>
                        </group>
                        <group>
                            <field name="phone"/>
                            <field name="website"/>
                            <field name="latitude"/>
                            <field name="longitude"/>
                            <field name="location_rating"/>
                        </group>
                        <!-- <group>
                        </group> -->
                        <group>
                            <field name="scheduling_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Opening Hours">
                            <div class="row">
                                <div class="col-6">
                                    <table class="table table-bordered text-center">
                                        <thead class="bg-light">
                                            <tr>
                                                <th>Day</th>
                                                <th>Is Open</th>
                                                <th>Opening Hours</th>
                                                <th>Closing Hours</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr>
                                                <td>Monday</td>
                                                <td><field name="mon"/></td>
                                                <td><field name="opening_hours_mon" readonly="not mon" required="mon"/></td>
                                                <td><field name="closing_hours_mon" readonly="not mon" required="mon"/></td>
                                            </tr>
                                            <tr>
                                                <td>Tuesday</td>
                                                <td><field name="tue"/></td>
                                                <td><field name="opening_hours_tue" readonly="not tue" required="tue"/></td>
                                                <td><field name="closing_hours_tue" readonly="not tue" required="tue"/></td>
                                            </tr>
                                            <tr>
                                                <td>Wednesday</td>
                                                <td><field name="wed"/></td>
                                                <td><field name="opening_hours_wed" readonly="not wed" required="wed"/></td>
                                                <td><field name="closing_hours_wed" readonly="not wed" required="wed"/></td>
                                            </tr>
                                            <tr>
                                                <td>Thursday</td>
                                                <td><field name="thu"/></td>
                                                <td><field name="opening_hours_thu" readonly="not thu" required="thu"/></td>
                                                <td><field name="closing_hours_thu" readonly="not thu" required="thu"/></td>
                                            </tr>
                                            <tr>
                                                <td>Friday</td>
                                                <td><field name="fri"/></td>
                                                <td><field name="opening_hours_fri" readonly="not fri" required="fri"/></td>
                                                <td><field name="closing_hours_fri" readonly="not fri" required="fri"/></td>
                                            </tr>
                                            <tr>
                                                <td>Saturday</td>
                                                <td><field name="sat"/></td>
                                                <td><field name="opening_hours_sat" readonly="not sat" required="sat"/></td>
                                                <td><field name="closing_hours_sat" readonly="not sat" required="sat"/></td>
                                            </tr>
                                            <tr>
                                                <td>Sunday</td>
                                                <td><field name="sun"/></td>
                                                <td><field name="opening_hours_sun" readonly="not sun" required="sun"/></td>
                                                <td><field name="closing_hours_sun" readonly="not sun" required="sun"/></td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </page>

                        <page string="Comments">
                            <field name="location_comment_ids">
                                <tree editable="bottom">
                                    <field name="comment_type"/>
                                    <field name="comment_description"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Contacts">
                            <field name="brokerage_location_contacts_ids">
                                <tree editable="bottom">
                                    <field name="location_contact_type"/>
                                    <field name="name"/>
                                    <field name="email"/>
                                    <field name="phone"/>
                                    <field name="references"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_brokerage_location" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">brokerage.location</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_brokerage_location" name="Locations" parent="freight_brokerage.brokerage_menu_main" action="action_brokerage_location" sequence="20"/>

</odoo>
