<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="brokerage_order_stop_details_view_tree" model="ir.ui.view">
        <field name="name">brokerage.order.stop.details.view.tree</field>
        <field name="model">brokerage.stop.details</field>
        <field name="arch" type="xml">
            <tree string="Brokerage Order Stop Details">
                <field name="customer_reference_id"/>
                <field name="customer_po_number"/>
                <field name="customer_delivery_po"/>
                <field name="quantity"/>
                <field name="unit_description"/>
                <field name="weight"/>
                <field name="weight_uom"/>
                <field name="volume"/>
                <field name="volume_uom"/>
            </tree>
        </field>
    </record>

    <record id="brokerage_order_stop_details_view_form" model="ir.ui.view">
        <field name="name">brokerage.order.stop.details.view.form</field>
        <field name="model">brokerage.stop.details</field>
        <field name="arch" type="xml">
            <form string="Brokerage Order Stop Details">
                <sheet>
                    <group>
                        <group>
                            <field name="customer_reference_id"/>
                            <field name="customer_po_number"/>
                            <field name="customer_delivery_po"/>
                            <field name="quantity"/>
                            <field name="unit_description"/>
                        </group>
                        <group>
                            <field name="weight"/>
                            <field name="weight_uom"/>
                            <field name="volume"/>
                            <field name="volume_uom"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>
