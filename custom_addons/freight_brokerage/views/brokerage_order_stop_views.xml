<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="freight_brokerage.brokerage_order_stop_view_tree" model="ir.ui.view">
        <field name="name">brokerage.order.stop.view.tree</field>
        <field name="model">brokerage.order.stop</field>
        <field name="arch" type="xml">
            <tree string="Brokerage Order Stops">
                <field name="stop_number"/>
                <field name="stop_type"/>
                <field name="driver_loading"/>
                <field name="location_id"/>
                <field name="location_type"/>
                <field name="is_appointment_confirmed"/>
                <field name="scheduled_earliest"/>
                <field name="scheduled_latest"/>
                <field name="actual_check_in_time"/>
                <field name="actual_check_out_time"/>
                <field name="no_of_pallets"/>
                <field name="weight"/>
                <field name="weight_uom_id" options="{'no_create_edit': True,'no_create': True, 'no_quick_create': True, 'no_open': True}"/>
                <field name="no_of_units"/>
                <field name="no_of_units_description_id" options="{'no_create_edit': True,'no_create': True, 'no_quick_create': True, 'no_open': True}"/>
                <field name="volume"/>
                <field name="volume_uom_id" options="{'no_create_edit': True,'no_create': True, 'no_quick_create': True, 'no_open': True}"/>
            </tree>
        </field>
    </record>

    <record id="freight_brokerage.brokerage_order_stop_view_form" model="ir.ui.view">
        <field name="name">brokerage.order.stop.view.form</field>
        <field name="model">brokerage.order.stop</field>
        <field name="arch" type="xml">
            <form string="Stop Details">
                <sheet>
                    <group>
                        <group string="Stop Information">
                            <field name="stop_number"/>
                            <field name="stop_type"/>
                            <field name="driver_loading"/>
                        </group>
                        <group string="Location">
                            <field name="location_id"/>
                            <field name="location_type"/>
                            <field name="is_appointment_confirmed"/>
                        </group>
                        <group string="Timing">
                            <field name="scheduled_earliest"/>
                            <field name="scheduled_latest"/>
                            <field name="actual_check_in_time"/>
                            <field name="actual_check_out_time"/>
                        </group>
                        <group string="Shipment Information">
                            <field name="no_of_pallets"/>
                            <field name="weight"/>
                            <field name="weight_uom_id" options="{'no_create_edit': True,'no_create': True, 'no_quick_create': True, 'no_open': True}"/>
                            <field name="no_of_units"/>
                            <field name="no_of_units_description_id" options="{'no_create_edit': True,'no_create': True, 'no_quick_create': True, 'no_open': True}"/>
                            <field name="volume"/>
                            <field name="volume_uom_id" options="{'no_create_edit': True,'no_create': True, 'no_quick_create': True, 'no_open': True}"/>
                        </group>
                    </group>

                    <notebook>
                        <page name="comments" string="Comments">
                            <field name="stop_comment_ids">
                                <tree editable="bottom">
                                    <field name="comment_type"/>
                                    <field name="comment_description"/>
                                </tree>
                            </field>
                        </page>

                        <page name="stop_references" string="Stops References">
                            <field name="brokerage_order_stop_reference_ids">
                                <tree editable="bottom">
                                    <field name="reference_identification_qualifier"/>
                                    <field name="reference"/>
                                </tree>
                            </field>
                        </page>

                        <page name="stop_details" string="Stops Details">
                            <field name="stop_detail_ids">
                                <tree editable="bottom">
                                    <field name="customer_reference_id"/>
                                    <field name="customer_po_number"/>
                                    <field name="customer_delivery_po"/>
                                    <field name="quantity"/>
                                    <field name="unit_description"/>
                                    <field name="weight"/>
                                    <field name="weight_uom"/>
                                    <field name="volume"/>
                                    <field name="volume_uom"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>

            </form>
        </field>
    </record>

    <!-- <record model="ir.actions.act_window" id="action_brokerage_order_stop">
        <field name="name">Brokerage Order Stop</field>
        <field name="res_model">brokerage.order.stop</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
            id="menu_brokerage_order_stop"
            name="Brokerage Order Stop"
            action="action_brokerage_order_stop"
            parent="brokerage_menu_main"
    /> -->

</odoo>
