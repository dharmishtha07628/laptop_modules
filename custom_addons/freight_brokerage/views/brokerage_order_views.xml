                            <field name="brokerage_order_stop_ids">
                                <tree>
                                    <field name="stop_number"/>
                                    <field name="stop_type"/>
                                    <field name="driver_loading"/>
                                    <field name="location_type"/>
                                    <field name="location_id"/>
                                    <field name="is_appointment_confirmed"/>
                                    <field name="scheduled_earliest"/>
                                    <field name="scheduled_latest"/>
                                    <field name="actual_check_in_time"/>
                                    <field name="actual_check_out_time"/>
                                    <field name="no_of_pallets"/>
                                    <field name="weight"/>
                                    <field name="weight_uom_id"/>
                                    <field name="no_of_units"/>
                                    <field name="no_of_units_description_id"/>
                                    <field name="volume"/>
                                    <field name="volume_uom_id"/>
                                </tree>
                            </field>
                        </page> -->

                        <page string="Order References" name="order_references">
                            <field name="brokerage_order_reference_ids">
                                <tree editable="bottom">
                                    <field name="reference_identification_qualifier" options="{'no_create_edit': True,'no_create': True, 'no_quick_create': True, 'no_open': True}"/>
                                    <field name="reference"/>
                                </tree>
                            </field>
                        </page>

                        <page string="Comments" name="comments">
                            <field name="brokerage_comment_ids">
                                <tree editable="bottom">
                                    <field name="comment_type"/>
                                    <field name="comment_description"/>
                                </tree>
                            </field>
                        </page>

                    </notebook>

