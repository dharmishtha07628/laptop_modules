<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="brokerage_order_view_tree" model="ir.ui.view">
         <field name="name">brokerage.order.view.tree</field>
         <field name="model">brokerage.order</field>
         <field name="arch" type="xml">
             <tree string="Brokerage Order">
                <field name="order_source"/>
                <field name="shipment_id_number"/>
                <field name="shipment_method_of_payment"/>
                <field name="must_respond_by"/>
                <field name="accepted_or_rejected"/>
                <field name="order_status"/>
                <field name="external_reference"/>
                <field name="customer_order_no"/>
            </tree>
        </field>
    </record>

    <record id="brokerage_order_view_form" model="ir.ui.view">
        <field name="name">brokerage.order.view.form</field>
        <field name="model">brokerage.order</field>
        <field name="arch" type="xml">
            <form string="Brokerage Order">
                <header>
                    <field name="order_status" widget="statusbar"/>
                </header>
                <sheet>
                    <div>
                        <h1 style="font-size: 1.9rem;">
                            <div class="row">
                                <div class="col col-md-auto">
                                    <label for="name" string="Order Number"/>
                                    <div>
                                        <field name="name" placeholder="Order Number" class="oe_inline"/>
                                    </div>
                                </div>
                            </div>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="order_source"/>
                            <field name="shipment_method_of_payment"/>
                            <field name="must_respond_by"/>
                        </group>

                        <group>
                            <field name="accepted_or_rejected"/>
                            <field name="order_status"/>
                            <field name="external_reference"/>
                            <field name="customer_order_no"/>
                        </group>
                    </group>

                    <notebook>

                        <page string="Stops" name="stops" autofocus="autofocus">
                            <field name="brokerage_order_stop_ids" mode="kanban" class="brokerage_order_stop_ids">
                                <kanban default_order="stop_number ASC">
                                    <field name="id"/>
                                    <templates>
                                        <t t-name="kanban-box">
                                            <div class="oe_kanban_global_click">
                                                <div class="oe_kanban_details">
                                                    <div class="row">
                                                        <div class="col-6">
                                                            <strong>Stop Information</strong>
                                                            <table class="table border-0">
                                                                <tr>
                                                                    <td>Stop Number: </td>
                                                                    <td><field name="stop_number"/></td>
                                                                </tr>
                                                                <tr>
                                                                    <td>Driver Loading</td>
                                                                    <td><field name="driver_loading"/></td>
                                                                </tr>
                                                                <tr>
                                                                    <td>Stop Type</td>
                                                                    <td><field name="stop_type"/></td>
                                                                </tr>
                                                            </table>
                                                        </div>
                                                        <div class="col-6">
                                                            <strong>Location</strong>
                                                            <table class="table border-0">
                                                                <tr>
                                                                    <td>Location</td>
                                                                    <td><field name="location_id"/></td>
                                                                </tr>
                                                                <tr>
                                                                    <td>Location Type: </td>
                                                                    <td><field name="location_type"/></td>
                                                                </tr>
                                                                <tr>
                                                                    <td>Appointment Confirmed</td>
                                                                    <td><field name="is_appointment_confirmed"/></td>
                                                                </tr>
                                                            </table>
                                                        </div>

                                                        <div class="col-6">
                                                            <strong>Timing Section</strong>
                                                            <table class="table border-0">
                                                                <tr>
                                                                    <td>Scheduled Earliest</td>
                                                                    <td><field name="scheduled_earliest"/></td>
                                                                </tr>
                                                                <tr>
                                                                    <td>Scheduled Latest: </td>
                                                                    <td><field name="scheduled_latest"/></td>
                                                                </tr>
                                                                <tr>
                                                                    <td>Actual Check In Time</td>
                                                                    <td><field name="actual_check_in_time"/></td>
                                                                </tr>
                                                                <tr>
                                                                    <td>Actual Check Out Time</td>
                                                                    <td><field name="actual_check_out_time"/></td>
                                                                </tr>
                                                            </table>
                                                        </div>

                                                        <div class="col-6">
                                                            <strong>Shipment Information</strong>
                                                            <table class="table border-0">
                                                                <tr>
                                                                    <td>No Of Pallets</td>
                                                                    <td><field name="no_of_pallets"/></td>
                                                                </tr>
                                                                <tr>
                                                                    <td>Weight: </td>
                                                                    <td><field name="weight"/></td>
                                                                </tr>
                                                                <tr>
                                                                    <td>Weight UOM</td>
                                                                    <td><field name="weight_uom_id" options="{'no_create_edit': True,'no_create': True, 'no_quick_create': True, 'no_open': True}"/></td>
                                                                </tr>
                                                                <tr>
                                                                    <td>No Of Units</td>
                                                                    <td><field name="no_of_units"/></td>
                                                                </tr>
                                                                <tr>
                                                                    <td>No Of Units Description</td>
                                                                    <td><field name="no_of_units_description_id" options="{'no_create_edit': True,'no_create': True, 'no_quick_create': True, 'no_open': True}"/></td>
                                                                </tr>
                                                                <tr>
                                                                    <td>Volume</td>
                                                                    <td><field name="volume"/></td>
                                                                </tr>
                                                                <tr>
                                                                    <td>Volume UOM</td>
                                                                    <td><field name="volume_uom_id" options="{'no_create_edit': True,'no_create': True, 'no_quick_create': True, 'no_open': True}"/></td>
                                                                </tr>
                                                            </table>
                                                        </div>

                                                    </div>
                                                </div>
                                            </div>
                                        </t>
                                    </templates>
                                </kanban>
                            </field>
                        </page>

