                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_open_brokerage_order" model="ir.actions.act_window">
        <field name="name">Brokerage Order</field>
        <field name="res_model">brokerage.order</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="brokerage_menu_main" name="Brokerage"/>

    <menuitem id="brokerage_menu" name="Brokerage" parent="freight_brokerage.brokerage_menu_main"/>

    <menuitem id="brokerage_order_menu" name="Orders" parent="freight_brokerage.brokerage_menu" action="freight_brokerage.action_open_brokerage_order"/>

</odoo>
